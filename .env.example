# Copy to .env for local development. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/Exams?sslmode=require&channel_binding=require
DJANGO_RELAX_MYSQL_VERSION=0
DJANGO_DEBUG=True

# Render generates DJANGO_SECRET_KEY and configures secure cookies in render.yaml.
# For a custom domain, set these in Render (comma-separated):
# DJANGO_ALLOWED_HOSTS=your-app.onrender.com,exam.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://exam.example.com

# Optional local MySQL: remove DATABASE_URL and install requirements-mysql.txt.
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=anticheat_exam
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DJANGO_RELAX_MYSQL_VERSION=1  # Only for local XAMPP MariaDB 10.4
